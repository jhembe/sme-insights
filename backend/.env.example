# ── Database ──────────────────────────────────────────────────────────────────
# Local dev:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sme_insights_dev"

# Production (postgres container on data_net):
# DATABASE_URL="postgresql://sme_app:PASSWORD@postgres:5432/sme_insights"

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sme_insights_dev"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="generate-a-strong-random-secret-here"
JWT_REFRESH_SECRET="generate-a-different-strong-random-secret-here"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# ── Email / SMTP ─────────────────────────────────────────────────────────────
# Shared Gmail SMTP — same credentials used by dse-pulse (/opt/apps/dse-pulse/.env)
# Account: code.saphire@gmail.com (Google App Password, not login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=code.saphire@gmail.com
SMTP_PASS=your-16-char-google-app-password
SMTP_FROM="SME Insights <no-reply@mahembega.com>"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
# Frontend URL — used in password-reset emails (no trailing slash)
FRONTEND_URL=https://sme.mahembega.com
